# Copy to .env on the hosting machine. Never commit the filled file.
STU_DOMAIN=club.example.org
STU_ADMIN_EMAILS=admin@example.org
STU_MAIL_MODE=outbox
STU_SMTP_HOST=
STU_SMTP_PORT=587
STU_SMTP_USER=
STU_SMTP_PASSWORD=
STU_SMTP_SSL=false
STU_MAIL_FROM=
STU_FCM_PROJECT=
# For FCM: place the service account file in .secrets/fcm.json first.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/fcm.json
GOOGLE_APPLICATION_CREDENTIALS=

# Production starts with real institutions only. Explicit local catalog opt-in:
STU_SEED_CATALOG=false
# Optional JSON ICE server list. Use a TURN provider for restrictive networks.
STU_ICE_SERVERS_JSON=

# Initial owner bootstrap; supply real private values locally, never in Git.
STU_OWNER_EMAIL=
STU_OWNER_PASSWORD=
